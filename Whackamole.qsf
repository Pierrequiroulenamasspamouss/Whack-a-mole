set_global_assignment -name FAMILY "MAX V"
set_global_assignment -name DEVICE 5M160ZE64C5
set_global_assignment -name TOP_LEVEL_ENTITY Whackamole
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "01:21:05  MARCH 10, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR "-1"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name VHDL_FILE main.vhd
set_location_assignment PIN_25 -to leds[8]
set_location_assignment PIN_26 -to leds[7]
set_location_assignment PIN_40 -to leds[6]
set_location_assignment PIN_42 -to leds[5]
set_location_assignment PIN_44 -to leds[4]
set_location_assignment PIN_45 -to leds[3]
set_location_assignment PIN_46 -to leds[2]
set_location_assignment PIN_47 -to leds[1]
set_location_assignment PIN_53 -to leds[0]
set_location_assignment PIN_63 -to button[0]
set_location_assignment PIN_62 -to button[1]
set_location_assignment PIN_61 -to button[2]
set_location_assignment PIN_60 -to button[3]
set_location_assignment PIN_59 -to button[4]
set_location_assignment PIN_58 -to button[5]
set_location_assignment PIN_56 -to button[6]
set_location_assignment PIN_55 -to button[7]
set_location_assignment PIN_54 -to button[8]
set_location_assignment PIN_24 -to score_high
set_location_assignment PIN_21 -to startButton
set_location_assignment PIN_22 -to score_reset
set_location_assignment PIN_9 -to slowclock
set_location_assignment PIN_7 -to fastclock
set_location_assignment PIN_20 -to penalty_led